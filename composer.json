{
    "name": "metrictower/funnypot-laravel",
    "description": "Laravel adapter for funnypot: normalise the request, ask the funnypot-policy decision engine, execute the Decision (allow / log / block / deceive). Owns no decision logic.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "laravel",
        "honeypot",
        "deception",
        "security",
        "funnypot"
    ],
    "require": {
        "php": ">=8.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "illuminate/bus": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/console": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/contracts": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/http": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/queue": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/routing": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "metrictower/funnypot-policy": "^0.1",
        "metrictower/funnypot-core": "^0.3",
        "metrictower/funnypot-mainnet-client": "^0.1"
    },
    "require-dev": {
        "guzzlehttp/promises": "^1.5",
        "orchestra/testbench": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Funnypot\\Laravel\\": "src/Laravel/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Funnypot\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Funnypot\\Laravel\\FunnypotServiceProvider"
            ]
        }
    },
    "config": {
        "platform": {
            "php": "8.0.0"
        },
        "sort-packages": true
    }
}
